# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in real values.
# Safe to commit to version control (no secrets).
# ─────────────────────────────────────────────────────────────────────────────

FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
SECRET_KEY=your-very-secret-key-here

# Local PostgreSQL
DATABASE_URL=postgresql://postgres:root@localhost:5432/googlereviews

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

COMPANY_NAME=TechnoBuzz
COMPANY_ID=TECHNOBUZZ-001

APP_BASE_URL=http://localhost:5001

# Optional seed Place ID / review URL for TechnoBuzz (URL is auto-built from Place ID)
GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID

# Amazon S3 — business logo uploads (objects under logos/ must be publicly readable)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
# Optional CDN or custom host, e.g. https://cdn.example.com  (no trailing slash)
S3_PUBLIC_BASE_URL=
S3_LOGO_PREFIX=logos
# Leave empty when the bucket uses “Bucket owner enforced”. Set public-read only if ACLs are on.
S3_OBJECT_ACL=
