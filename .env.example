# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in real values.
# Safe to commit to version control (no secrets).
# ─────────────────────────────────────────────────────────────────────────────

FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=your-very-secret-key-here

MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=technobuzz_feedback

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

COMPANY_NAME=TechnoBuzz
COMPANY_ID=TECHNOBUZZ-001

APP_BASE_URL=http://localhost:5000

# Google Business Profile Review URL (find your Place ID at maps.google.com)
GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID
