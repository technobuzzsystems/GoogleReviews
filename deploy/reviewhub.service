[Unit]
Description=ReviewHub FastAPI (TechnoBuzz)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/reviewhub
EnvironmentFile=/var/www/reviewhub/.env
ExecStart=/var/www/reviewhub/.venv/bin/uvicorn app:app \
    --host 127.0.0.1 \
    --port 5001 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
